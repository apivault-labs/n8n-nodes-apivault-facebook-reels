    {
      "parameters": {
        "workflow": "profiles",
        "profileUrls": "https://www.facebook.com/nike",
        "maxReelsPerProfile": 200,
        "maxResults": 200,
        "outputPreset": "engagement",
        "downloadMp4": false,
        "includeTranscript": true,
        "dedupe": true
      },
      "id": "c6a5e2b2-f102-522a-9ab1-1319d0b7d2a8",
      "name": "Collect public Reels with Apify",
      "type": "n8n-nodes-apivault-facebook-reels.facebookReels",
      "typeVersion": 1,
      "position": [
        260,
        120
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const j = $json; const views = Number(j.viewCount ?? j.views ?? 0); const reactions = Number(j.reactionCount ?? j.reactions ?? 0); const comments = Number(j.commentCount ?? 0); return { json: { ...j, engagementTotal: reactions + comments, contentSummary: { creator: j.creatorName ?? '', caption: j.caption ?? '', views, reactions, comments, videoUrl: j.url ?? j.videoUrl ?? '' } } };"
      },
