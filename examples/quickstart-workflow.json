      "parameters": {
        "content": "## Setup\n1. Select your Apify API credential.\n2. Replace the sample public Page URL.\n3. Run manually or replace the trigger with Schedule Trigger.\n4. Connect the final summaries to your content tracker or alert channel.",
        "height": 260,
        "width": 440
      },
